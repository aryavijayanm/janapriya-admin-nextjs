generator client {
  provider = "prisma-client-js"
}

// Prisma 7 no longer accepts `url` here -- the connection string lives in
// prisma.config.ts for CLI commands (migrate/introspect), and is passed to
// PrismaClient at runtime through a driver adapter. See server/db/client.ts.
datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  STAFF
  OUTSIDER
}

// ACTIVE: normal, assignable. DISABLED: no new duties, but record and
// history stay visible. DELETED: soft-delete -- hidden from normal lists,
// but the row stays (never hard-deleted) so past duty/order records that
// reference this staffId keep resolving instead of breaking a foreign key.
enum StaffStatus {
  ACTIVE
  DISABLED
  DELETED
}

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique
  password      String
  name          String
  role          Role
  designation   String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz
  updated_at    DateTime  @updatedAt @db.Timestamptz
  last_login_at DateTime? @db.Timestamptz

  sessions             Session[]
  checkedContracts     Contract[] // contracts whose rate this user confirmed
  recordedPayments     Payment[]           @relation("PaymentRecordedBy")
  voidedPayments       Payment[]           @relation("PaymentVoidedBy")
  recordedRefunds      Refund[]            @relation("RefundRecordedBy")
  voidedRefunds        Refund[]            @relation("RefundVoidedBy")
  recordedStaffEntries StaffAccountEntry[] @relation("StaffEntryRecordedBy")
  voidedStaffEntries   StaffAccountEntry[] @relation("StaffEntryVoidedBy")
  staffSettlements     StaffSettlement[]
  orderWriteOffs       OrderWriteOff[]
}

// Database-backed sessions, deliberately not JWT: deleting a row revokes
// access immediately, which is what makes logout real, password changes
// kick out an attacker, and a disabled user lose access on their next
// request rather than whenever a token happens to expire.
//
// `id` is the SHA-256 hash of the random token held in the cookie, never
// the token itself -- so a stolen database dump contains no usable
// sessions. SHA-256 rather than bcrypt is correct here: the token is
// already 32 bytes of entropy, so there is nothing to brute-force and no
// reason to pay for slow hashing on every request.
model Session {
  id         String   @id
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime @db.Timestamptz
  created_at DateTime @default(now()) @db.Timestamptz

  @@index([userId])
}

model Service {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  abbreviation String   @unique
  is_active    Boolean  @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz
  updated_at   DateTime @updatedAt @db.Timestamptz

  staff  StaffService[]
  orders OrderService[]
}

model Staff {
  id                       Int         @id @default(autoincrement())
  name                     String
  place                    String
  contactNumber            String
  dob                      DateTime?   @db.Date
  guardianName             String?
  relationshipWithGuardian String?
  guardianContactNumber    String?
  verifiedAddress          String?
  idProof                  String?
  idNumber                 String?
  bankAccountDetails       String?
  rating                   Int         @default(5)
  remarks                  String?
  // Storage key of the photo (e.g. "staff/3f2a....jpg"), never a URL -- the
  // URL depends on where files live (local folder now, Cloudflare R2 later)
  // and is computed when the page renders. Null = no photo (it's optional).
  photoKey                 String?
  status                   StaffStatus @default(ACTIVE)
  // For the staff balances list ONLY (a fast look-up): the account balance
  // estimated until yesterday (+ = owed to the staff, - = the staff owes).
  // A stored copy, refreshed after every money change and by the nightly job.
  // Paying and clearing never read it -- the staff account page calculates live.
  balanceDue               Int         @default(0)
  created_at               DateTime    @default(now()) @db.Timestamptz
  updated_at               DateTime    @updatedAt @db.Timestamptz

  services       StaffService[]
  duties         StaffAssignment[]
  accountEntries StaffAccountEntry[]
  settlements    StaffSettlement[]

  @@index([balanceDue])
}

// Join table for Staff <-> Service. Deliberately no is_active column here --
// a staff member currently offering a service is represented by the row's
// existence; removing it (not flagging it) means "they stopped." Whether the
// service itself is still offered at all lives on Service.is_active, checked
// via the join at read time -- never copied/cached onto this table.
model StaffService {
  staffId   Int
  serviceId Int
  staff     Staff   @relation(fields: [staffId], references: [id])
  service   Service @relation(fields: [serviceId], references: [id])

  @@id([staffId, serviceId])
}

// Same three states as StaffStatus: DELETED hides a customer from every list,
// but the row stays, so their future orders and payment history keep resolving.
enum CustomerStatus {
  ACTIVE
  DISABLED
  DELETED
}

// The person who pays. One row per person, even with several orders.
//
// New tables use camelCase for EVERY column, timestamps included
// (createdAt, not created_at). Older tables keep their existing names.
model Customer {
  id             Int            @id @default(autoincrement())
  name           String
  address        String
  // Digits and an optional leading "+", no fixed prefix -- a customer can be
  // anywhere in the world. Duplicate detection compares the last 10 digits.
  contactNumber1 String
  contactNumber2 String?
  idProof        String?
  idNumber       String?
  email          String?
  remarks        String?
  status         CustomerStatus @default(ACTIVE)
  // Filled in automatically by Prisma. Can't be recovered later if left out:
  // "customer since", newest-first lists, monthly counts, and spotting two
  // people editing the same customer all depend on them.
  createdAt      DateTime       @default(now()) @db.Timestamptz
  updatedAt      DateTime       @updatedAt @db.Timestamptz

  orders CustomerOrder[]
}

// ===== Orders, contracts and staff duty ======================================
//
// Customer ──< CustomerOrder ──< Contract          (28 days of SERVICE each)
//                   │  └──< OrderService >── Service
//                   └──< StaffAssignment >── Staff (who worked, when)
//
// A contract's dates are CALCULATED from the duty periods: a day counts only
// if some staff covered it, so leave without a replacement stretches the
// contract. Only contract #1's start date is ever typed in.

// KERALA today; OUTSIDE is a planned expansion. OUTSIDER-role users can't see
// OUTSIDE orders (enforced in order.service).
enum Branch {
  KERALA
  OUTSIDE
}

// The first and last day of a duty period: worked the whole day, half, or was
// there without pay (joined late / left early) -- NO_PAY is never counted.
enum DayPart {
  FULL
  HALF
  NO_PAY
}

// One booking of care for a customer. A customer can have several.
model CustomerOrder {
  id              Int            @id @default(autoincrement())
  // 4 random consonants ("KXQT"), unique. Used in URLs and on screen instead
  // of the id, so OUTSIDE orders can't be found by guessing the next number.
  code            String         @unique
  customerId      Int
  customer        Customer       @relation(fields: [customerId], references: [id])
  branch          Branch         @default(KERALA)
  remarks         String?
  // Set by "End order": the last day of care. Null = still running.
  endDate         DateTime?      @db.Date
  // Why it ended ("Patient in hospital", "Family moved") -- optional.
  endNote         String?
  // "Restart": this order continues an ended one (new order, contracts from #1).
  // Unique, so an ended order can be restarted only once.
  restartedFromId Int?           @unique
  restartedFrom   CustomerOrder? @relation("OrderRestart", fields: [restartedFromId], references: [id])
  restartedAs     CustomerOrder? @relation("OrderRestart")
  createdAt       DateTime       @default(now()) @db.Timestamptz
  updatedAt       DateTime       @updatedAt @db.Timestamptz

  services  OrderService[]
  contracts Contract[]
  duties    StaffAssignment[]
  writeOff  OrderWriteOff?

  @@index([customerId])
  @@index([branch])
}

// Which services an order covers -- same shape as StaffService. A separate
// table (not an array) so the database guarantees every serviceId is real.
model OrderService {
  orderId   Int
  serviceId Int
  order     CustomerOrder @relation(fields: [orderId], references: [id])
  service   Service       @relation(fields: [serviceId], references: [id])

  @@id([orderId, serviceId])
}

// One 28-day billing period of an order.
model Contract {
  id              Int           @id @default(autoincrement())
  orderId         Int
  order           CustomerOrder @relation(fields: [orderId], references: [id])
  // 1, 2, 3 within the order -- what people see. (`id` is the database's own key.)
  contractNumber  Int
  // Every date is calculated from the duty periods (#1 starts on the first
  // paid duty day). Null while pending (no staff, so the end isn't known yet).
  startDate       DateTime?     @db.Date
  endDate         DateTime?     @db.Date
  // Days of service used so far, 0-28. Calculated with the dates. Shown as
  // "17 / 28", and used for refunds when an order stops early (step 2).
  servedDays      Int           @default(0)
  // Whole rupees. Copied from the previous contract, editable.
  rate            Int // what the customer pays for these 28 days of service
  staffSalary     Int // what staff earn per 28 days in this contract
  // true = created by the nightly job (rate copied, nobody chose it); false =
  // started by a person (Start care / the button). Kept forever as history.
  autoStarted     Boolean       @default(false)
  // Who confirmed the rate, and when ("Rate is correct", or saving the money).
  // The order page tags a contract "Auto-started · check rate" while
  // autoStarted is true and rateCheckedAt is still empty. SetNull: deleting a
  // user never fails because they once confirmed a rate.
  rateCheckedAt   DateTime?     @db.Timestamptz
  rateCheckedById Int?
  rateCheckedBy   User?         @relation(fields: [rateCheckedById], references: [id], onDelete: SetNull)
  // What the customer has paid. Calculated from the payments below (voided
  // ones don't count) and stored -- recalculated in the same transaction as
  // every payment or rate change, like servedDays.
  paymentStatus   PaymentStatus @default(NOT_PAID)
  paidAmount      Int           @default(0)
  // The paidOn date of the payment that completed the rate. Null unless fully paid.
  fullyPaidOn     DateTime?     @db.Date
  // Set by "End order": what the customer is charged for the days served
  // (rate / 28 x servedDays, rounded down). Null = the full rate (running order).
  // Paid status compares payments with this when set.
  charge          Int?
  // Total of the refunds recorded (voided ones don't count), kept like paidAmount.
  // Refund due = paidAmount - charge - refundedAmount, worked out, never stored.
  refundedAmount  Int           @default(0)
  // This contract's part of the order's write-off (see OrderWriteOff): what
  // the customer will never pay. Amount due = (charge ?? rate) - writtenOffAmount.
  writtenOffAmount Int          @default(0)
  payments        Payment[]
  refunds         Refund[]
  createdAt       DateTime      @default(now()) @db.Timestamptz
  updatedAt       DateTime      @updatedAt @db.Timestamptz

  @@unique([orderId, contractNumber])
  // The nightly job looks contracts up by end date.
  @@index([endDate])
}

// How a customer's money reached us. Recording only -- no money moves through
// the app. PAID_TO_STAFF matters for staff money later (step 3).
enum PaymentMode {
  CASH_OFFICE
  CASH_OWNER
  TO_ACCOUNT
  PAID_TO_STAFF
  OTHER
}

enum PaymentStatus {
  NOT_PAID
  PARTLY_PAID
  FULLY_PAID
}

// One payment by a customer, against ONE contract. No orderId on purpose:
// payment -> contract -> order is one join, and a second copy of the order
// could disagree with the contract's. Never edited: a mistake is voided (it
// stays, crossed out, with who/when/why) and recorded again -- only while the
// order is running. After End order, money entries are final.
model Payment {
  id             Int         @id @default(autoincrement())
  contractId     Int
  contract       Contract    @relation(fields: [contractId], references: [id])
  amount         Int // whole rupees, more than 0
  // The day the customer paid -- typed by the user (often recorded later).
  paidOn         DateTime    @db.Date
  mode           PaymentMode
  accountDetails String? // optional, e.g. "Rama SBI"
  recordedById   Int?
  recordedBy     User?       @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  // Set when voided. A voided payment stops counting but is never deleted.
  voidedAt       DateTime?   @db.Timestamptz
  voidedById     Int?
  voidedBy       User?       @relation("PaymentVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason     String?
  createdAt      DateTime    @default(now()) @db.Timestamptz

  @@index([contractId])
}

// Money given BACK to a customer after "End order" (they paid more than the
// charge for the days served). Never edited and never voided (money entries
// are final after End order); never more than the refund due. The voided*
// columns stay only for rows voided before that rule.
model Refund {
  id             Int         @id @default(autoincrement())
  contractId     Int
  contract       Contract    @relation(fields: [contractId], references: [id])
  amount         Int // whole rupees, more than 0
  refundedOn     DateTime    @db.Date
  mode           PaymentMode // how it was given back (PAID_TO_STAFF not used)
  accountDetails String?
  remarks        String
  recordedById   Int?
  recordedBy     User?       @relation("RefundRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  voidedAt       DateTime?   @db.Timestamptz
  voidedById     Int?
  voidedBy       User?       @relation("RefundVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason     String?
  createdAt      DateTime    @default(now()) @db.Timestamptz

  @@index([contractId])
}

// The Owner's final decision that an ended order's unpaid balance will never
// be collected. Once per order (orderId is unique), never edited, never undone.
// It covers the whole remaining balance of every contract still owing; each
// contract's part is kept in Contract.writtenOffAmount.
model OrderWriteOff {
  id           Int           @id @default(autoincrement())
  orderId      Int           @unique
  order        CustomerOrder @relation(fields: [orderId], references: [id])
  amount       Int // total written off, whole rupees
  writtenOffOn DateTime      @db.Date
  reason       String
  recordedById Int?
  recordedBy   User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now()) @db.Timestamptz
}

// One duty period: one staff member working on one order from a date, until a
// date (null = still working there). Leave is NOT a row -- it's the gap
// between two periods.
//
// Linked to the ORDER, not a contract: one period often spans several
// contracts, and contract dates are calculated FROM these periods, so a
// contractId here would have to be re-split every time leave moved a contract
// boundary. "Who worked on contract #2" = periods whose dates overlap #2's.
// The contract link is frozen later, in the step-3 earned (salary) rows.
model StaffAssignment {
  id           Int                @id @default(autoincrement())
  orderId      Int
  order        CustomerOrder      @relation(fields: [orderId], references: [id])
  staffId      Int
  staff        Staff              @relation(fields: [staffId], references: [id])
  startDate    DateTime           @db.Date
  startDayPart DayPart            @default(FULL)
  endDate      DateTime?          @db.Date
  endDayPart   DayPart?
  // Optional "why" when someone stops ("hospitalised", "family function").
  // There's deliberately no leave/replaced/exit field: on the day someone
  // stops nobody knows which it is. The app works it out from what happens
  // next on the order (same staff returns = leave, someone else starts =
  // handover, nothing yet = "no staff since").
  endNote      String?
  createdAt    DateTime           @default(now()) @db.Timestamptz
  updatedAt    DateTime           @updatedAt @db.Timestamptz
  // What staff salary clearings paid for this duty period.
  settledRows  StaffSettledDuty[]

  @@index([orderId])
  @@index([staffId])
}

// ---------------------------------------------------------------------------
// Staff account (step 3): a passbook per staff member.
//
// EARNED is not stored: it's calculated from duty periods x the staff salary
// of the contract each day belongs to (/ 28), so it's always up to date.
// What IS stored:
//   StaffAccountEntry -- every amount paid to the staff, or extra added for them
//   StaffSettlement   -- each "Clear the salary now"
//   StaffSettledDuty  -- what each clearing paid, per duty period x contract
// Settled vs To settle: for each duty period x contract the app compares what
// was paid (latest StaffSettledDuty row) with what is worked now; any
// difference -- late duty, a corrected date, a moved contract boundary -- is
// "To settle" until the next clearing. Nothing is ever rewritten or deleted.
// ---------------------------------------------------------------------------

// PAID: money given to the staff (salary, advance, recharge...) -- minus.
// EXTRA: a one-time amount added for them (e.g. Rs 500 extra) -- plus.
// RECEIVED: money the staff paid back to us -- plus (closes what they owe).
// WRITE_OFF: what they owe, forgiven by the owner -- plus (closes it, no money moves).
// RECEIVED and WRITE_OFF are allowed only while the staff owes, up to what they owe.
enum StaffEntryType {
  PAID
  EXTRA
  RECEIVED
  WRITE_OFF
}

// How money moved (PAID and RECEIVED entries only).
enum StaffPaymentMode {
  CASH_OFFICE
  CASH_OWNER
  CASH_CUSTOMER
  ONLINE_TRANSFER
  OTHER
}

// One payment or extra. Never edited: a mistake is voided (kept, crossed
// out). Once settlementId is set (cleared) it is Settled and can't be voided.
model StaffAccountEntry {
  id             Int               @id @default(autoincrement())
  staffId        Int
  staff          Staff             @relation(fields: [staffId], references: [id])
  type           StaffEntryType
  // Effect on the balance, whole rupees: PAID < 0; EXTRA, RECEIVED, WRITE_OFF > 0.
  amount         Int
  // The true date it happened (date of pay / of the extra), even if entered later.
  entryDate      DateTime          @db.Date
  remarks        String
  mode           StaffPaymentMode? // PAID and RECEIVED only
  accountDetails String?
  recordedById   Int?
  recordedBy     User?             @relation("StaffEntryRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  voidedAt       DateTime?         @db.Timestamptz
  voidedById     Int?
  voidedBy       User?             @relation("StaffEntryVoidedBy", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason     String?
  // The clearing that settled it. Null = To settle.
  settlementId   Int?
  settlement     StaffSettlement?  @relation(fields: [settlementId], references: [id])
  createdAt      DateTime          @default(now()) @db.Timestamptz

  @@index([staffId, settlementId])
}

// One "Clear the salary now": the totals as agreed that day. Never undone.
model StaffSettlement {
  id          Int                 @id @default(autoincrement())
  staffId     Int
  staff       Staff               @relation(fields: [staffId], references: [id])
  clearedOn   DateTime            @db.Date
  earned      Int // duty differences paid in this clearing (can include minus rows)
  extras      Int // EXTRA entries settled in this clearing
  recovered   Int                 @default(0) // RECEIVED + WRITE_OFF entries settled in this clearing
  paid        Int // PAID entries before the final payment (positive number)
  // What was paid to clear it. Negative = the staff owed this much; it opens the next period.
  finalAmount Int
  clearedById Int?
  clearedBy   User?               @relation(fields: [clearedById], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now()) @db.Timestamptz
  settledDuty StaffSettledDuty[]
  entries     StaffAccountEntry[]

  @@index([staffId, clearedOn])
}

// What one clearing paid for one duty period x contract.
//   fromDate/toDate/halfDays/amount -- what THIS clearing paid (can be minus:
//                                       "paid before, no longer worked")
//   settled*                         -- the running total paid for this duty x
//                                       contract after this clearing: the
//                                       latest row is "what has been paid"
// Order code and customer name are copied in, so the passbook still reads
// right if they change later.
model StaffSettledDuty {
  id              Int             @id @default(autoincrement())
  settlementId    Int
  settlement      StaffSettlement @relation(fields: [settlementId], references: [id])
  staffId         Int
  dutyId          Int
  duty            StaffAssignment @relation(fields: [dutyId], references: [id])
  orderId         Int
  orderCode       String
  customerName    String
  contractNumber  Int
  staffSalary     Int
  fromDate        DateTime        @db.Date
  toDate          DateTime        @db.Date
  halfDays        Int // days x 2 paid in this clearing (minus allowed)
  amount          Int // rupees paid in this clearing (minus allowed)
  settledFrom     DateTime?       @db.Date // null = nothing left paid (fully reversed)
  settledTo       DateTime?       @db.Date
  settledHalfDays Int
  settledAmount   Int

  @@index([settlementId])
  @@index([staffId, dutyId, contractNumber])
}
